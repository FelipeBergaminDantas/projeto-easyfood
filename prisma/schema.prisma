// Prisma Schema para EasyFood
// Provider: PostgreSQL
// Models: User, Restaurant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("users")
}

model Restaurant {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  description String?
  address     String
  phone       String
  rating      Float    @default(0.0)
  createdAt   DateTime @default(now())

  @@map("restaurants")
}
